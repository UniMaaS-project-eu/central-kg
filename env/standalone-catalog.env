###############################################
# Federated Catalog with STS + Filesystem Vault
###############################################

# keycloak
keycloak_admin_user=admin
keycloak_admin_password=admin
keycloak_host=keycloak
keycloak_port=8080
keycloak_realm=unimaas

# Participant identity
edc.participant.id=did:web:edc-proxy-connectorcp%3A80:connectorcp
edc.iam.issuer.id=did:web:edc-proxy-connectorcp%3A80:connectorcp
# edc.iam.did.web.use.https=false
edc.iam.did.web.resolution.endpoint=http://edc-ih-connectorcp:7093/api/identity/v1alpha/did
edc.iam.token.provider=privatekey
edc.iam.token.signer.privatekey.alias=did:web:edc-proxy-connectorcp%3A80:connectorcp#key-1
edc.iam.token.verifier.publickey.id==did:web:edc-proxy-connectorcp%3A80:connectorcp-alias

edc.vault.hashicorp.url=http://edc-vault-connectorcp:8200
edc.vault.hashicorp.api.secret.path=/v1/secret
edc.vault.hashicorp.api.health.check.path=/v1/sys/health
edc.vault.hashicorp.health.check.enabled=true
edc.vault.hashicorp.health.check.standby.ok=false
edc.vault.hashicorp.health.check.retry.retries=3
edc.vault.hashicorp.health.check.retry.interval.seconds=5
edc.vault.certificate.resolver.enabled=true
edc.vault.privatekey.resolver.enabled=true
edc.vault.hashicorp.token=hvs.CAESIAnklLfxyANMsWRzccKD0ll-DM3hxKiVIt1c__i6MPDnGh4KHGh2cy5zT3BDcTJqejZ2cGd4ZjUyVWxSYTJIRU4

# STS OAuth client
edc.iam.sts.oauth.client.id=did:web:edc-proxy-connectorcp%3A80:connectorcp
edc.iam.sts.oauth.client.secret.alias=did:web:edc-proxy-connectorcp%3A80:connectorcp-sts-client-secret
edc.iam.sts.oauth.token.url=http://edc-ih-connectorcp:7095/api/sts/token
edc.iam.sts.oauth.scope=
edc.iam.sts.oauth.audience=did:web:localhost%3A10100

# audience
edc.oauth.validation.audience.enabled=false

# Default API
web.http.port=8180
web.http.path=/api

# Management API (Secrets API included)
web.http.management.port=8181
web.http.management.path=/api/management
web.http.management.auth.type=tokenbased
web.http.management.auth.key=password
edc.management.context.enabled=true

# DSP
web.http.protocol.port=8182
web.http.protocol.path=/api/dsp
edc.api.dsp.enabled=true
edc.api.dsp.context.alias=protocol
edc.dsp.callback.address=http:///172.17.0.1:8182/api/dsp
edc.dsp.callback.auth.audience.validation.enabled=false
edc.dsp.auth.audience.validation.enabled=false

# DCP
edc.dcp.client.credentials.enabled=false

# Control API
web.http.control.port=8183
web.http.control.path=/api/control

# Catalog API
web.http.catalog.port=8184
web.http.catalog.path=/api/catalog
edc.api.catalog.enabled=true

# version api
web.http.version.port=8185
web.http.version.path=/api/version


